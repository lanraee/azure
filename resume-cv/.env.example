# Clerk (auth for /admin) — from https://dashboard.clerk.com or the Vercel Marketplace Clerk integration
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Vercel Blob (content storage) — auto-provisioned when a Blob store is connected to the project
BLOB_READ_WRITE_TOKEN=

# Comma-separated list of the only email addresses allowed into /admin.
# Required even with Clerk configured - anyone can otherwise sign up for a
# Clerk account and reach the dashboard.
ADMIN_EMAILS=
